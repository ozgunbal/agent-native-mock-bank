{
  "extends": "@agent-native/core/tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "rootDirs": [
      ".",
      "./.react-router/types"
    ],
    "paths": {
      "*": [
        "./*"
      ],
      "@/*": [
        "./app/*"
      ],
      "@shared/*": [
        "./shared/*"
      ]
    },
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "app/**/*",
    "server/**/*",
    "shared/**/*",
    "scripts/**/*",
    "vite.config.ts",
    "react-router.config.ts",
    ".react-router/types/**/*",
    ".generated/**/*"
  ]
}
